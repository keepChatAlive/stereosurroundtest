#include "resource.h"

IDI_APP_ICON ICON "@APP_ICON_PATH@"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Stereo Surround Project\0"
            VALUE "FileDescription", "@APP_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "@APP_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@APP_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "7.1 Speaker Virtualizer\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
